#!/usr/bin/env sh
# Blocks feat/fix commits, and chore(deps) commits, that don't stage a CHANGELOG.md entry.
# chore(deps) is included because every dependency update needs an entry regardless of
# user-facing impact — see CLAUDE.md's Changelog Hard Constraint.
# Escape hatch for non-user-facing feat/fix commits outside that exception: git commit --no-verify

commit_msg_file="$1"
subject=$(head -n1 "$commit_msg_file")

if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix)(\([^)]*\))?!?:|^chore\(deps\)!?:'; then
  exit 0
fi

if git diff --cached --name-only | grep -qx 'CHANGELOG.md'; then
  exit 0
fi

cat >&2 <<'EOF'
error: 'feat'/'fix'/'chore(deps)' commit without a CHANGELOG.md entry staged.

Add a line under ## [Unreleased] in CHANGELOG.md, then: git add CHANGELOG.md

Not user-facing? feat/fix outside the dependency/security-hardening exception can
skip this check with: git commit --no-verify (dependency updates and security/privacy
hardening always need an entry — no escape hatch for those, see CLAUDE.md).
EOF
exit 1
