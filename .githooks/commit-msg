#!/usr/bin/env sh
# Blocks feat/fix commits that don't stage a CHANGELOG.md entry.
# Escape hatch for non-user-facing feat/fix commits: git commit --no-verify

commit_msg_file="$1"
subject=$(head -n1 "$commit_msg_file")

if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix)(\([^)]*\))?!?:'; then
  exit 0
fi

if git diff --cached --name-only | grep -qx 'CHANGELOG.md'; then
  exit 0
fi

cat >&2 <<'EOF'
error: 'feat'/'fix' commit without a CHANGELOG.md entry staged.

Add a line under ## [Unreleased] in CHANGELOG.md, then: git add CHANGELOG.md

Not user-facing? Skip this check with: git commit --no-verify
EOF
exit 1
