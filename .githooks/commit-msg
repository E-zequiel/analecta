#!/usr/bin/env sh
# Blocks user-facing feat/fix commits that don't stage a CHANGELOG.md entry.
# CHANGELOG.md records user-visible changes only — dependency updates
# (chore(deps)/fix(deps), manual, scripted, or Dependabot) get no entry.
# Security/privacy changes the user can feel: full writeup in
# docs/security-log.md, plus a terse CHANGELOG ### Security line referencing
# it. Security-relevant internals the user never touches: security-log only.
# Escape hatch for non-user-facing feat/fix commits: git commit --no-verify

commit_msg_file="$1"
subject=$(head -n1 "$commit_msg_file")

if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix)(\([^)]*\))?!?:'; then
  exit 0
fi

scope=$(printf '%s\n' "$subject" | sed -n 's/^\(feat\|fix\)(\([^)]*\)).*/\2/p')
if [ "$scope" = "deps" ]; then
  exit 0
fi

if git diff --cached --name-only | grep -qx 'CHANGELOG.md'; then
  exit 0
fi

cat >&2 <<'EOF'
error: user-facing 'feat'/'fix' commit without a CHANGELOG.md entry staged.

Add a line under ## [Unreleased] in CHANGELOG.md, then: git add CHANGELOG.md

Not user-facing? Non-user-facing feat/fix can skip this check with:
git commit --no-verify (chore(deps)/fix(deps) are exempt entirely — dependency
updates are never registered in CHANGELOG by policy; user-felt security
changes carry a terse CHANGELOG line plus the docs/security-log.md writeup,
invisible security internals go to docs/security-log.md only).
EOF
exit 1
