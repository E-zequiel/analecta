#!/usr/bin/env bash
# Analecta CLI wrapper — run the sidecar CLI without `python -m`.
#
# Default: executes the packaged sidecar CLI binary at
# binaries/analecta-sidecar/analecta-sidecar (owner decision D3) — same
# binary, same schema.
# Attached mode (a live app sidecar is discovered via the 0600 session file)
# and standalone mode behave exactly as documented in the CLI module.
#
# Fallback to live backend code (`mise exec -- uv run python -m analecta`)
# when the binary is absent or ANALECTA_CLI_DEV=1 — keeps the dev loop on
# fresh code without rebuilding the PyInstaller bundle.
#
# Never runs without a subcommand: a bare invocation starts the sidecar
# server, and Electron owns that lifecycle — not terminal users.
set -euo pipefail

if [ $# -eq 0 ]; then
	echo "usage: analecta <extract|index|log|summary|synthesize> [args...]" >&2
	echo "error: a subcommand is required; the server form is owned by Electron" >&2
	exit 64
fi

# Resolve the wrapper's real path first: invoked through a symlink (e.g.
# ~/.local/bin/analecta), BASH_SOURCE points at the link, not the script.
self="$(readlink -f "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$self")/.." && pwd)"
# Note the doubled name: the --onedir layout nests the executable inside a
# directory of the same name.
bin="$repo_root/binaries/analecta-sidecar/analecta-sidecar"

case "${ANALECTA_CLI_DEV:-}" in
1 | true | yes) dev=1 ;;
*) dev=0 ;;
esac

if [ "$dev" = 1 ] || [ ! -x "$bin" ]; then
	cd "$repo_root/backend"
	# Dev-tool fallback chain: mise (toolchain manager) → standalone uv →
	# an existing backend/.venv. All three run the same module; only the
	# tooling differs. Nothing else is required.
	if command -v mise >/dev/null 2>&1; then
		exec mise exec -- uv run python -m analecta "$@"
	fi
	if command -v uv >/dev/null 2>&1; then
		echo "warning: mise not found; running through standalone uv" >&2
		exec uv run python -m analecta "$@"
	fi
	if [ -x "$repo_root/backend/.venv/bin/python" ]; then
		echo "warning: mise and uv not found; using the existing backend/.venv" >&2
		exec "$repo_root/backend/.venv/bin/python" -m analecta "$@"
	fi
	echo "error: no way to run the CLI: install mise (https://mise.dev) or uv (https://docs.astral.sh/uv/), or build the packaged sidecar (mise exec -- python scripts/build_sidecar.py)" >&2
	exit 69
fi

exec "$bin" "$@"
