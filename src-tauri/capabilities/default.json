{
  "identifier": "default",
  "description": "Default window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "notification:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-url",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "deep-link:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    "process:allow-restart",
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "/nonexistent/analecta-sentinel" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "/nonexistent/analecta-sentinel" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "/nonexistent/analecta-sentinel" }] }
  ]
}
