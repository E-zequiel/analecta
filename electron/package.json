{
  "name": "analecta-electron",
  "version": "0.5.2",
  "description": "Local PKM desktop app — URL extraction to Markdown vault",
  "author": {
    "name": "Ezequiel Lazzari",
    "email": "build@mail.analecta.app"
  },
  "homepage": "https://github.com/E-zequiel/analecta",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
