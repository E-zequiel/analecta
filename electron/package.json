{
  "name": "analecta-electron",
  "version": "0.6.1",
  "description": "Local PKM desktop app — URL extraction to Markdown vault",
  "author": {
    "name": "Ezequiel Lazzari",
    "email": "build@mail.analecta.app"
  },
  "homepage": "https://github.com/E-zequiel/analecta",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && VITE_DEV_SERVER_URL=http://localhost:5173 electron dist/main/index.js",
    "test": "vitest run",
    "dist": "tsc && electron-builder --config ../electron-builder.yml --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
