    "dist": "tsc && electron-builder --config ../electron-builder.yml --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "electron": "42.5.1",
    "electron-builder": "26.15.6",
    "typescript": "6.0.3"
  }
}
